<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Toolbar at the top -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Course Manager"
        app:titleTextColor="@android:color/white" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Edit text to enter course name -->
            <EditText
                android:id="@+id/idEdtCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Enter Course Name" />

            <!-- Edit text to enter course duration -->
            <EditText
                android:id="@+id/idEdtCourseDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Enter Course Duration" />

            <!-- Edit text to enter course tracks -->
            <EditText
                android:id="@+id/idEdtCourseTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Enter Course Tracks" />

            <!-- Edit text to enter course description -->
            <EditText
                android:id="@+id/idEdtCourseDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Enter Course Description" />

            <!-- Button to add new course -->
            <Button
                android:id="@+id/idBtnAddCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Add Course"
                android:textAllCaps="false" />

            <!-- Button to read all courses -->
            <Button
                android:id="@+id/idBtnReadCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Read All Courses"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
